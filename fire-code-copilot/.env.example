# =====================================================================
#  Fire Code CoPilot — environment configuration
#  Copy to .env and fill in. .env is gitignored (never commit secrets).
#  Every value here maps to a field in backend/app/settings.py.
# =====================================================================

# ---------- Generation (the answer model) ----------
# "local"     = an OpenAI-compatible server (LM Studio / mlx_lm.server / Ollama)
# "anthropic" = Claude API (needs ANTHROPIC_API_KEY)
GENERATION_PROVIDER=local
LOCAL_BASE_URL=http://localhost:1234/v1
LOCAL_MODEL=glm-5.2
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-sonnet-4-6

# Optional escalation for hard questions (kept local by default).
DEEP_PROVIDER=local
DEEP_MODEL=glm-5.2

# ---------- Embeddings ----------
# "local"  = sentence-transformers, nothing leaves the machine (default, most private)
# "voyage" = Voyage legal-tuned embeddings (small per-token cost; needs VOYAGE_API_KEY)
EMBEDDING_PROVIDER=local
# Default local model is BAAI/bge-m3 (~2.2 GB download, best quality).
# For a fast/light setup (e.g. CI or a first smoke test) you can point this at a
# small model, e.g.:  sentence-transformers/all-MiniLM-L6-v2  (~90 MB)
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-law-2

# ---------- Reranker (two-stage retrieval) ----------
USE_RERANKER=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RETRIEVE_BEFORE_RERANK=20
KEEP_AFTER_RERANK=6

# ---------- Citation safety ----------
VALIDATE_CITATIONS=true

# ---------- Paths / app ----------
JURISDICTION=City of Hartford, Connecticut
CODE_BOOKS_DIR=./code_books
DATA_DIR=./data
CODE_CYCLES_CONFIG=./config/code_cycles.yaml
CHROMA_DIR=./data/chroma
# Chroma collection for the active edition (one collection per edition).
ACTIVE_COLLECTION=csfsc_2022

# ---------- Generation tuning ----------
TEMPERATURE=0.1
