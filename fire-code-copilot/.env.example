# =====================================================================
#  Fire Code CoPilot — environment configuration
#  Copy to .env and fill in. .env is gitignored (never commit secrets).
#  Every value here maps to a field in backend/app/settings.py.
# =====================================================================

# ---------- Generation (oMLX single-endpoint answer path) ----------
GENERATION_PROVIDER=local
LOCAL_BASE_URL=http://localhost:8010/v1
LOCAL_API_KEY=not-needed
GENERATOR_MODEL=granite-4.0-h-small-MLX-8bit
GENERATOR_MODELS=granite-4.0-h-small-MLX-8bit,gemma-4-26b-a4b-it-4bit,Ornith-1.0-35B-bf16
MLX_THINKING=off

# Optional cloud escalation for the hardest <2%; disabled by default and never local-reasoning.
DEEP_PROVIDER=off
DEEP_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-opus-4-8

# Legacy / non-answer providers kept only for old configs and dev experiments; not used on the
# grounded answer path.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=
GGUF_MODEL_PATH=
GGUF_N_CTX=8192
GGUF_N_GPU_LAYERS=-1
MLX_MODEL=

# ---------- Embeddings + reranking (also served by the same oMLX endpoint) ----------
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=bge-m3-mlx-fp16
LOCAL_EMBEDDING_MODEL=bge-m3-mlx-fp16
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-law-2
USE_RERANKER=true
RERANKER_MODEL=BAAI-bge-reranker-v2-m3-mlx-fp16
# Optional stronger reranker: Qwen/Qwen3-Reranker-4B
RETRIEVE_BEFORE_RERANK=20
KEEP_AFTER_RERANK=6
RERANK_MIN_SCORE=0.35
MAX_RETRIEVAL_RETRIES=2
USE_HYBRID=false

# ---------- Citation safety + OCR ----------
VALIDATE_CITATIONS=true
EXTRACT_TABLES=false
OCR_MODEL=olmOCR-2-7B-1025-8bit
OCR_TABLE_MODEL=mlx-community/PaddleOCR-VL-8bit
OCR_TABLE_ENABLED=false
USE_OCR=false
OCR_DPI=200
OCR_CACHE_VERSION=omlx-md-v1
# Set this for a full candidate re-ingest; e.g. csfsc_2022__ocr-bgem3-v1. Leaves ACTIVE_COLLECTION intact.
INDEX_VERSION_SUFFIX=
INGEST_VERSION=ocr-bgem3-v1

# ---------- Paths / app ----------
JURISDICTION="City of Hartford, Connecticut"
CODE_BOOKS_DIR=./code_books
DATA_DIR=./data
CODE_CYCLES_CONFIG=./config/code_cycles.yaml
CHROMA_DIR=./data/chroma
# Chroma collection for the active adopted code edition (one collection per edition).
ACTIVE_COLLECTION=csfsc_2022
# Current CGS statutory collection used automatically for unmistakably statutory questions (CGS / §29-xxx).
STATUTES_COLLECTION=ct_general_statutes_chapter_541_2025_2026
VERIFIED_MATCH_THRESHOLD=0.82
RUNTIME_STATE_FILE=./data/runtime_models.json

# ---------- Generation tuning ----------
TEMPERATURE=0.1
LOCAL_MODEL=granite-4.0-h-small-MLX-8bit
